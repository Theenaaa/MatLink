PROJECT_NAME=CANONIX
VERSION=1.0.0
DEBUG=True
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# 1. Local PostgreSQL:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/canonix

# 2. Render Hosted PostgreSQL:
# (Uncomment and replace with your Render External/Internal Database URL)
# DATABASE_URL=postgresql+psycopg2://<user>:<password>@<render-host>.oregon-postgres.render.com/<dbname>?sslmode=require

# ------------------------------------------------------------------------------
# Security & JWT
# ------------------------------------------------------------------------------
JWT_SECRET=canonix_super_secure_enterprise_secret_key_sih_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# CORS Origins (Comma-separated or JSON list)
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# ------------------------------------------------------------------------------
# AI & Matching Configuration
# ------------------------------------------------------------------------------
SEMANTIC_WEIGHT=0.40
ATTRIBUTE_WEIGHT=0.30
RULE_WEIGHT=0.20
CLASSIFICATION_WEIGHT=0.10

EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
VECTOR_DIMENSION=384
