# CANONIX Platform Environment Configuration

# Database (PostgreSQL)
# Local:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/canonix
# Render Hosted PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://<user>:<password>@<render-host>.oregon-postgres.render.com/<dbname>?sslmode=require

POSTGRES_DB=canonix
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Security & JWT
JWT_SECRET=canonix_super_secure_enterprise_secret_key_sih_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server & CORS
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# AI Models
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
VECTOR_DIMENSION=384

# Frontend API Endpoint
NEXT_PUBLIC_API_URL=http://localhost:8000
# For Render Frontend -> Backend:
# NEXT_PUBLIC_API_URL=https://canonix-backend.onrender.com
